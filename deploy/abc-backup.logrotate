# /etc/logrotate.d/abc-backup — rotation for /var/log/abc-backup.log
#
# rclone logs at INFO on every run, so this file only grows. Left alone it is
# the one thing on the server that fills the disk slowly enough to go
# unnoticed — and a full disk is exactly what breaks the backup it records.
#
# copytruncate, not create: the running script holds the file open through
# `--log-file`, so a rename would leave rclone writing into an unlinked inode.
/var/log/abc-backup.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
