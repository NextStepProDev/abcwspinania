# Kopiuj do .env NA SERWERZE produkcyjnym (w katalogu deployu) i uzupełnij.
# Ten plik nigdy nie zawiera prawdziwych wartości — .env jest w .gitignore.
#
# Sekrety generuj poleceniem:  openssl rand -hex 32
# Hex, nie base64: base64 potrafi wylosować "/", który rozcina DATABASE_URI.
# Każdy osobno; ten sam ciąg w dwóch polach znosi sens ich rozdzielenia.

# --- Baza danych ---
POSTGRES_DB=abcwspinania
POSTGRES_USER=abcwspinania
POSTGRES_PASSWORD=ZMIEN_NA_MOCNE_HASLO

# --- Aplikacja ---
# Podpisuje tokeny sesji panelu. MUSI być inny niż lokalnie.
PAYLOAD_SECRET=ZMIEN_MNIE

# --- Maile (Brevo) ---
# Klucz API z Brevo: Settings → SMTP & API → API Keys. Bez niego maile lądują
# tylko w logu kontenera — strona działa, ale nikt nic nie dostaje.
BREVO_API_KEY=
# Nadawca. MUSI być na domenie uwierzytelnionej w Brevo (SPF + DKIM), inaczej
# Brevo odrzuci wysyłkę albo mail trafi do spamu. Testowo domena tymczasowa,
# docelowo domena szkoły — zmiana tylko tutaj, bez nowego obrazu.
EMAIL_FROM=zapisy@szkolawspinaczkowa.pl
EMAIL_FROM_NAME=ABC Wspinania
# Kto dostaje powiadomienia o nowych wiadomościach i zapisach.
ADMIN_NOTIFY_EMAIL=

# --- Adres strony dla linków w mailach ---
# Pod tym adresem strona działa TERAZ. Linki w mailach do kursantów
# (potwierdzenie konta, ustawienie hasła) prowadzą tutaj. Puste = SITE_URL
# z obrazu, czyli domena docelowa — do dnia przełączenia prowadziłaby na
# starą stronę. W dniu przełączenia zmienić na adres domeny docelowej.
# Celowo NIE z nagłówka Host żądania: podrobiony Host wstawiłby obcą domenę
# do linku z jednorazowym kodem do zmiany hasła.
PUBLIC_URL=https://szkolawspinaczkowa.pl

# --- Obraz (GHCR) ---
GHCR_OWNER=nextstepprodev
# Nadpisywane przez deploy.yml wartością z pliku VERSION w repo.
VERSION=latest

# --- Budżet pamięci ---
# Wartości domyślne (w docker-compose.prod.yml) zakładają CAŁĄ darmową maszynę
# Ampere: 2 OCPU / 12 GB. Nie trzeba tu nic ustawiać, żeby ich użyć.
#
# PROFIL „POŁ MASZYNY" — odkomentuj, gdy dzielisz darmowy limit Ampere na dwie
# instancje po 1 OCPU / 6 GB. Limity kontenerów I strojenie idą razem (patrz
# docker-compose.prod.yml) — nie trzeba już ręcznie edytować pliku compose.
# POSTGRES_MEM_LIMIT=512m
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
# POSTGRES_WORK_MEM=4MB
# POSTGRES_MAINTENANCE_WORK_MEM=32MB
# POSTGRES_MAX_CONNECTIONS=20
# APP_MEM_LIMIT=1g
# NODE_MAX_OLD_SPACE_SIZE=768
# NGINX_MEM_LIMIT=64m
