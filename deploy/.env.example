# Copy to .env ON THE PRODUCTION SERVER (in the deploy directory) and fill in.
# This file never holds real values — .env is in .gitignore.
#
# Generate secrets with:  openssl rand -hex 32
# Hex, not base64: base64 can draw a "/", which splits DATABASE_URI.
# Each one separately; the same string in two fields defeats keeping them apart.

# --- Database ---
POSTGRES_DB=abcwspinania
POSTGRES_USER=abcwspinania
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Application ---
# Signs the panel's session tokens. MUST differ from the local one.
PAYLOAD_SECRET=CHANGE_ME

# --- Emails (Brevo) ---
# The Brevo API key: Settings → SMTP & API → API Keys. Without it emails land
# only in the container log — the site works, but nobody receives anything.
BREVO_API_KEY=
# Three mailboxes, one per kind of email (web/src/lib/email/mailboxes.ts):
# courses → COURSE_EMAIL, camps → CAMP_EMAIL, everything else → EMAIL_FROM and
# ADMIN_NOTIFY_EMAIL. Each mailbox is the sender, where replies go and where the
# school's notifications arrive. A change here only, no new image.
#
# The general sender (accounts, newsletter, contact form, broadcasts to
# everyone). MUST be on a domain authenticated in Brevo (SPF + DKIM), or Brevo
# rejects the send or the email lands in spam. For the school:
# biuro@abcwspinania.info.
EMAIL_FROM=zapisy@szkolawspinaczkowa.pl
EMAIL_FROM_NAME=ABC Wspinania
# Who gets the contact form messages; also the fallback for the two below.
ADMIN_NOTIFY_EMAIL=
# The courses mailbox (kursy@abcwspinania.info): course emails come from it,
# course booking and "a place is free" notifications arrive in it, replies go
# to it. Empty = EMAIL_FROM as the sender, ADMIN_NOTIFY_EMAIL for the rest.
# It becomes the sender only when it is on the domain of EMAIL_FROM.
COURSE_EMAIL=
# The camps mailbox (obozy@abcwspinania.info): the same for camps — and where
# signed contracts come back. Empty = like COURSE_EMAIL empty.
CAMP_EMAIL=

# --- The site address for links in emails ---
# The address the site runs at NOW. Links in emails to participants (account
# confirmation, setting a password) lead here. Empty = SITE_URL from the image,
# i.e. the target domain — until the switch it would lead to the old site. On
# the day of the switch change it to the target domain's address.
# Deliberately NOT from the request's Host header: a forged Host would put a
# foreign domain into a link carrying a one-time password-change code.
PUBLIC_URL=https://szkolawspinaczkowa.pl

# --- Obraz (GHCR) ---
GHCR_OWNER=nextstepprodev
# Overwritten by deploy.yml with the value from the VERSION file in the repo.
VERSION=latest

# --- Memory budget ---
# The defaults (in docker-compose.prod.yml) assume the WHOLE free Ampere
# machine: 2 OCPU / 12 GB. Nothing needs setting here to use them.
#
# THE "HALF MACHINE" PROFILE — uncomment when you split the free Ampere
# allowance into two instances of 1 OCPU / 6 GB each. Container limits AND
# tuning go together (see docker-compose.prod.yml) — the compose file no longer
# needs editing by hand.
# POSTGRES_MEM_LIMIT=512m
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
# POSTGRES_WORK_MEM=4MB
# POSTGRES_MAINTENANCE_WORK_MEM=32MB
# POSTGRES_MAX_CONNECTIONS=20
# APP_MEM_LIMIT=1g
# NODE_MAX_OLD_SPACE_SIZE=768
# NGINX_MEM_LIMIT=64m
