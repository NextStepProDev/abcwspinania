# Wspólne ustawienia edytora, niezależne od tego, w czym kto pracuje.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# W Markdownie dwie spacje na końcu linii to twarde złamanie wiersza.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
