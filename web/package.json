{
  "name": "abcwspinania",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/test-resolver.mjs --test \"src/**/*.test.ts\"",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "seed": "NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "seed:test": "NODE_OPTIONS=--no-deprecation payload run scripts/test-data/courses.ts",
    "seed:test:courses": "NODE_OPTIONS=--no-deprecation payload run scripts/test-data/courses.ts",
    "seed:test:camps": "NODE_OPTIONS=--no-deprecation payload run scripts/test-data/camps.ts",
    "sweep": "NODE_OPTIONS=--no-deprecation payload run scripts/sweep.ts",
    "audit": "node scripts/audit-gate.mjs",
    "test:integration": "BREVO_API_KEY= NODE_OPTIONS=--no-deprecation payload run tests/integration/run.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@pdf-lib/fontkit": "1.1.1",
    "graphql": "^16.14.2",
    "next": "16.4.3",
    "payload": "3.92.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
