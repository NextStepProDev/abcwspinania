    "react-dom": "19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^6"
  },
  "engines": {
    "node": ">=20.9.0"
  },
