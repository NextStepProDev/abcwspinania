# Skopiuj do .env i uzupełnij. Produkcja bierze te wartości z deploy/.env.

# Baza. Port 5435 to ten projekt — rejestr portów w ../CLAUDE.md.
DATABASE_URI=postgresql://abcwspinania:abcwspinania@127.0.0.1:5435/abcwspinania

# Podpisuje tokeny sesji panelu. Wygeneruj: openssl rand -base64 32
# MUSI być inny na produkcji niż lokalnie.
PAYLOAD_SECRET=ZMIEN_MNIE

# Adres bazowy dla sitemap, robots i canonicali.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
