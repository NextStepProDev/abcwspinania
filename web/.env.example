# Copy to .env and fill in. Production takes these values from deploy/.env.

# Database. Port 5435 is this project — the port registry is in ../CLAUDE.md.
DATABASE_URI=postgresql://abcwspinania:abcwspinania@127.0.0.1:5435/abcwspinania

# Signs the panel's session tokens. Generate: openssl rand -hex 32
# MUST differ between production and local.
PAYLOAD_SECRET=CHANGE_ME

# The base address for the sitemap, robots and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails through Brevo — the variables are described in ../deploy/.env.example.
# Empty = emails printed to the development server's console, nothing goes out.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ABC Wspinania
ADMIN_NOTIFY_EMAIL=
# Locally keep these two EMPTY: a mailbox is also the sender, and the school's
# Brevo key never goes into this file — an address like a private Gmail would
# not pass SPF/DKIM (the code refuses a sender off EMAIL_FROM's domain anyway).
COURSE_EMAIL=
CAMP_EMAIL=
# The address in links from emails (account, password). Locally: http://localhost:3000
PUBLIC_URL=http://localhost:3000
